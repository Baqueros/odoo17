<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="sh_pos_stock_information.ProductsWidget" t-inherit="point_of_sale.ProductsWidget" t-inherit-mode="extension">
        <xpath expr="//ProductCard" position="attributes">
            <attribute name="qty_available" >product.qty_available</attribute>
            <attribute name="virtual_available" >product.virtual_available</attribute>
            <attribute name="product_type" >product.type</attribute>
            <attribute name="order_product_qty" >pos.order_product_qty</attribute>
            <attribute name="sh_manage_stock" >pos.config.sh_manage_stock</attribute>
            <attribute name="sh_enable_on_hand_qty" >pos.config.sh_enable_on_hand_qty</attribute>
        </xpath>
    </t>
</templates>